{
  "version": "longitudinal_v2_2",
  "seed": 366,
  "event": "first_observed_current_established_smoking",
  "baseline_waves": [1, 2, 3, 4, 5, 6, 7],
  "minimum_followup_interviews": 1,
  "wave_windows": {
    "1": ["2013-09-01", "2014-12-31"],
    "2": ["2014-10-01", "2015-10-31"],
    "3": ["2015-10-01", "2016-10-31"],
    "4": ["2016-12-01", "2018-01-31"],
    "5": ["2018-12-01", "2019-11-30"],
    "6": ["2021-03-01", "2021-11-30"],
    "7": ["2022-01-01", "2023-04-30"],
    "8": ["2024-01-01", "2024-12-31"]
  },
  "timing_source": "https://www.fda.gov/tobacco-products/research/fda-and-nih-study-population-assessment-tobacco-and-health",
  "timing_assumption": "Each interview is assigned the midpoint of its wave's collection window. A first observed return is known only to lie between the previous and the observing interview (interval censoring); the model uses that interval, not a point time. Participants without a later interview are censored at their last interview.",
  "feature_profiles": {
    "compact": ["age_band", "education_level", "employment_status", "last_cigarette_recency_days", "electronic_nicotine_p30d", "household_tobacco_any", "mental_health", "emotional_problems_7d"],
    "extended": ["age_band", "education_level", "employment_status", "last_cigarette_recency_days", "electronic_nicotine_p30d", "household_tobacco_any", "mental_health", "emotional_problems_7d", "home_combustible_smoking_rules", "physical_health", "social_satisfaction"]
  },
  "regularization": [1.0, 10.0, 30.0],
  "baseline_hazard_knots_months": [0, 12, 24, 36, 48],
  "selection_horizons_months": [18, 36, 60],
  "display_horizons_months": [12, 18, 24, 36, 48, 60],
  "default_horizon_months": 36,
  "maximum_horizon_months": 60,
  "minimum_horizon_at_risk": 100,
  "compact_preference_loglik_tolerance": 0.002,
  "minimum_answers_fraction": 0.75,
  "bootstrap_repetitions": 200,
  "background_size": 128,
  "data_dir": "data/processed/longitudinal_v2_2",
  "artifact_dir": "artifacts/longitudinal_v2_2",
  "report_dir": "reports/longitudinal_v2_2"
}
